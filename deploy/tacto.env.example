# Production settings: copy to /etc/tacto/tacto.env (owner root, group tacto,
# mode 640). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/tacto/cmms.sqlite
# Generate with: openssl rand -base64 48   (at least 32 characters in production)
JWT_SECRET=
JWT_EXPIRES_IN=8h
APP_TIMEZONE=Europe/Paris
BACKUP_DIR=/var/backups/tacto
BACKUP_KEEP_DAYS=14
# Only needed to load the mock data (demo): npm run db:seed
SEED_PASSWORD=
