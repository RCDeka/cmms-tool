# Alerts (Phase 29, D75): copy to /etc/tacto/notify.env (owner root, group tacto, mode 640).
# Never commit the real file. README → Deployment, step 3 ("Alerts").

# ntfy topic that receives the alerts (failed units, disk almost full). On ntfy.sh anyone who
# knows the topic name can read it: make it unguessable (tacto-$(openssl rand -hex 12)), or use
# a protected topic with an access token, or your own ntfy server.
NOTIFY_URL=https://ntfy.sh/tacto-CHANGE-ME
# Access token of a protected topic (tk_…); empty for a public topic.
NOTIFY_TOKEN=

# Dead man's switch pinged after each nightly backup (e.g. a healthchecks.io check with a 1 day
# period and a 2 hour grace time, which alerts the same ntfy topic when a ping is missing).
HEARTBEAT_URL=

# Warn when a disk holding these paths is this full (percent). Defaults:
# DISK_ALERT_PERCENT=80
# DISK_PATHS=/var/lib/tacto /var/backups/tacto
