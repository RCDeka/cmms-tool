# Off-server backups (D72): copy to /etc/tacto/offsite.env (owner root, group tacto, mode 640).
# Never commit the real file. README → Deployment, step 3 ("Off-server backups").

# Where the copies go: storage of ANOTHER provider or place than this VPS. Keep one line.
RESTIC_REPOSITORY=s3:https://s3.example.com/tacto-backups
# RESTIC_REPOSITORY=b2:tacto-backups:/
# RESTIC_REPOSITORY=sftp:backup@backup.example.com:/srv/tacto-backups

# Encryption password of the copies. Generate with: openssl rand -base64 32
# KEEP A COPY OUTSIDE THIS SERVER (password manager): without it no copy can ever be read.
RESTIC_PASSWORD=

# Keys of the storage: S3-compatible (OVH, Scaleway, AWS, MinIO…)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# … or Backblaze B2
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# SFTP uses the SSH key of the tacto user (/var/lib/tacto/.ssh), no setting here.

# Copies kept (defaults): 14 daily, 8 weekly, 12 monthly.
# OFFSITE_KEEP_DAILY=14
# OFFSITE_KEEP_WEEKLY=8
# OFFSITE_KEEP_MONTHLY=12
