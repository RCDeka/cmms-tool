# Checks the disk space every 6 hours (install as /etc/systemd/system/tacto-disk-check.timer and
# enable with: systemctl enable --now tacto-disk-check.timer). While a disk stays above the
# threshold, the warning comes back at each check.
[Unit]
Description=Tacto disk space check every 6 hours

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h

[Install]
WantedBy=timers.target
