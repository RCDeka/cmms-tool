# Runs the database backup every night (install as /etc/systemd/system/tacto-backup.timer
# and enable with: systemctl enable --now tacto-backup.timer).
[Unit]
Description=Daily Tacto database backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=10min
# Catch up after a reboot if the server was off at 02:30.
Persistent=true

[Install]
WantedBy=timers.target
