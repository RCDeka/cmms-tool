# Daily release of preventive work orders (install as
# /etc/systemd/system/tacto-pm-release.service). Started by tacto-pm-release.timer;
# run it by hand with: systemctl start tacto-pm-release
# Creates the work orders of the maintenance plan visits due within the release horizon
# (4 weeks by default). Running it twice creates nothing more (BR-P6).
[Unit]
Description=Tacto release of preventive work orders
After=tacto.service
OnFailure=tacto-notify@%n.service

[Service]
Type=oneshot
User=tacto
Group=tacto
WorkingDirectory=/opt/tacto/backend
EnvironmentFile=/etc/tacto/tacto.env
ExecStart=/usr/bin/node src/db/cli.js release
UMask=0077
# Writes the live database in /var/lib/tacto, and a backup in /var/backups/tacto when the
# command applies pending migrations (an update not yet followed by a restart).
StateDirectory=tacto
ReadWritePaths=/var/backups/tacto
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
