# Releases the preventive work orders every morning (install as
# /etc/systemd/system/tacto-pm-release.timer and enable with:
# systemctl enable --now tacto-pm-release.timer).
[Unit]
Description=Daily release of Tacto preventive work orders

[Timer]
# After the nightly backup (02:30), before the teams start.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
