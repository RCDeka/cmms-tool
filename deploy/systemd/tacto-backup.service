# Daily database backup (install as /etc/systemd/system/tacto-backup.service).
# Started by tacto-backup.timer; run it by hand with: systemctl start tacto-backup
[Unit]
Description=Tacto database backup
After=tacto.service
# Then the off-server copy (D72), only when this backup succeeded.
OnSuccess=tacto-offsite-backup.service

[Service]
Type=oneshot
User=tacto
Group=tacto
WorkingDirectory=/opt/tacto/backend
EnvironmentFile=/etc/tacto/tacto.env
ExecStart=/usr/bin/node src/db/cli.js backup
UMask=0077
# Reads the live database (and its WAL files), writes /var/backups/tacto.
StateDirectory=tacto
ReadWritePaths=/var/backups/tacto
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
