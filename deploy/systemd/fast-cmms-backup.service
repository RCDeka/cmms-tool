# Daily database backup (install as /etc/systemd/system/fast-cmms-backup.service).
# Started by fast-cmms-backup.timer; run it by hand with: systemctl start fast-cmms-backup
[Unit]
Description=Fast-CMMS database backup
After=fast-cmms.service

[Service]
Type=oneshot
User=fast-cmms
Group=fast-cmms
WorkingDirectory=/opt/fast-cmms/backend
EnvironmentFile=/etc/fast-cmms/fast-cmms.env
ExecStart=/usr/bin/node src/db/cli.js backup
UMask=0077
# Reads the live database (and its WAL files), writes /var/backups/fast-cmms.
StateDirectory=fast-cmms
ReadWritePaths=/var/backups/fast-cmms
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
