# Tacto API server (install as /etc/systemd/system/tacto.service).
[Unit]
Description=Tacto API server
Documentation=https://github.com/RCDeka/cmms-tool
After=network.target

[Service]
Type=simple
User=tacto
Group=tacto
WorkingDirectory=/opt/tacto/backend
# Secrets and settings (JWT_SECRET, DATABASE_PATH, …): root-owned, readable by the group.
EnvironmentFile=/etc/tacto/tacto.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# Creates /var/lib/tacto (database) owned by the service user.
StateDirectory=tacto
StateDirectoryMode=0750
UMask=0077
# Backup written before pending migrations are applied at start.
ReadWritePaths=/var/backups/tacto

# Sandboxing: the service can only write its own state directory and the backups.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
