{
  "name": "tacto-backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "Tacto API server (Express + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "node src/db/cli.js migrate",
    "db:seed": "node src/db/cli.js seed",
    "db:reset": "node src/db/cli.js reset",
    "db:backup": "node src/db/cli.js backup",
    "feedback:export": "node src/db/cli.js feedback",
    "pm:release": "node src/db/cli.js release",
    "user:create-admin": "node src/db/cli.js create-admin",
    "check:permissions": "node scripts/check-permissions.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
