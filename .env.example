NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/cmms.sqlite
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=8h
# Your time zone (IANA name): "today", overdue work, weeks. In production, also in the timers.
APP_TIMEZONE=Europe/Paris
SEED_PASSWORD=change-me-now
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14
# AI assistant (docs/spec-ai-assistant.md): none = search results only, until a provider is chosen
AI_PROVIDER=none
AI_TIMEOUT_MS=15000
